{
  "name": "pointer",
  "displayName": "Pointer",
  "description": "Editor-native coding agent on TrueForge: finds the right code, proposes multi-file changes, and shows every hunk for review before it touches disk.",
  "version": "0.1.0-beta",
  "icon": "assets/icon.png",
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "trueforge",
    "mcp",
    "inline-edit",
    "diff-review",
    "vscode-extension"
  ],
  "repository": {
    "url": "https://github.com/pointersh/Pointer"
  },
  "license": "MIT",
  "publisher": "pointer",
  "engines": {
    "vscode": "^1.106.0"
  },
  "bugs": {
    "url": "https://github.com/pointersh/Pointer/issues"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "author": {
    "name": "Ayush Yadav",
    "email": "ayush421301@gmail.com",
    "url": "https://thatayush.com"
  },
  "main": "./out/index.js",
  "contributes": {
    "menus": {
      "editor/context": [
        {
          "when": "editorTextFocus && !editorReadonly",
          "command": "pointer.edit"
        },
        {
          "when": "editorTextFocus",
          "command": "pointer.addFileToContext"
        },
        {
          "when": "editorHasSelection",
          "command": "pointer.addSelectionToContext"
        }
      ],
      "view/title": [
        {
          "command": "pointer.newConversation",
          "when": "view == pointer.sidebar",
          "group": "navigation@8"
        },
        {
          "command": "pointer.settings",
          "when": "view == pointer.sidebar",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "pointer.acceptEdit",
          "when": "pointerInlineEditPending"
        },
        {
          "command": "pointer.rejectEdit",
          "when": "pointerInlineEditPending"
        }
      ],
      "explorer/context": [
        {
          "command": "pointer.addFileToContext",
          "group": "pointer@1",
          "when": "!explorerResourceIsFolder"
        }
      ]
    },
    "commands": [
      {
        "command": "pointer.edit",
        "title": "Pointer - Edit with instruction..."
      },
      {
        "command": "pointer.acceptEdit",
        "title": "Pointer - Accept edit"
      },
      {
        "command": "pointer.rejectEdit",
        "title": "Pointer - Reject edit"
      },
      {
        "command": "pointer.enable",
        "shortTitle": "Enable pointer",
        "title": "Enable pointer"
      },
      {
        "command": "pointer.stopGeneration",
        "title": "Stop generation"
      },
      {
        "command": "pointer.disable",
        "title": "Disable pointer",
        "shortTitle": "Disable pointer"
      },
      {
        "command": "pointer.sidebar.focus",
        "shortTitle": "Enable pointer sidebar",
        "title": "Enable pointer sidebar"
      },
      {
        "command": "pointer.settings",
        "shortTitle": "pointer settings",
        "title": "Open pointer settings",
        "icon": "$(gear)"
      },
      {
        "command": "pointer.newConversation",
        "shortTitle": "New chat",
        "title": "Start a new chat",
        "icon": "$(plus)"
      },
      {
        "command": "pointer.showLogs",
        "title": "Pointer - Show logs"
      },
      {
        "command": "pointer.addFileToContext",
        "title": "Pointer - Add file to context"
      },
      {
        "command": "pointer.addSelectionToContext",
        "title": "Pointer: Add Selection to Context"
      }
    ],
    "keybindings": [
      {
        "key": "ctrl+i",
        "mac": "cmd+i",
        "command": "pointer.edit",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "key": "CTRL+SHIFT+/",
        "command": "pointer.stopGeneration",
        "when": "pointerGeneratingText"
      },
      {
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "command": "pointer.acceptEdit",
        "when": "pointerInlineEditPending && editorTextFocus"
      },
      {
        "key": "ctrl+shift+backspace",
        "mac": "cmd+shift+backspace",
        "command": "pointer.rejectEdit",
        "when": "pointerInlineEditPending && editorTextFocus"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "pointer-sidebar-view",
          "title": "pointer",
          "icon": "assets/pointer-sidebar.png"
        }
      ]
    },
    "views": {
      "pointer-sidebar-view": [
        {
          "type": "webview",
          "id": "pointer.sidebar",
          "name": "pointer",
          "icon": "assets/pointer-sidebar.png",
          "contextualTitle": "pointer"
        }
      ]
    },
    "configuration": {
      "title": "pointer",
      "properties": {
        "pointer.trueforgeUrl": {
          "scope": "machine",
          "type": "string",
          "default": "http://localhost:8790",
          "description": "Where the local TrueForge server runs (`npx @truefoundry/trueforge@latest`)."
        },
        "pointer.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Models to use, in order, as `provider/model` names configured in TrueForge. If a turn fails on one, Pointer retries on the next. Empty uses `pointer/primary`, then `pointer-backup/primary`."
        },
        "pointer.inlineModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Models for inline edits (Ctrl+I), in order, like `pointer.models`. Empty uses `pointer.models`. A fast model here makes inline edits quicker without changing agent mode."
        },
        "pointer.reasoningEffort": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "Reasoning effort per model, sent to TrueForge as `reasoning_effort`. Defaults: `pointer/primary` → `low`, `pointer-backup/primary` → `none`. Values are provider-specific: on Makora, GLM-5.3-Flash reasons fully unless set to `low`, and DeepSeek-V4.1-Flash unless set to `none`. Measured with `benchmarks/models.mjs`: first answer token falls from 20 s to 1.3 s."
        },
        "pointer.retrievalPath": {
          "scope": "machine",
          "type": "string",
          "default": "",
          "description": "Path to the pointer-retrieval binary. Empty uses target/release/pointer-retrieval inside the extension."
        },
        "pointer.semanticSearch": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Add local semantic search (`bge-small-en-v1.5`, run in-process; no API calls) to retrieval. The first run downloads the model (~133 MB) and embeds the workspace in the background (about 30 s for a Flask-sized repo). Search never waits for it: BM25, symbols and the repo map answer meanwhile."
        },
        "pointer.embeddingIgnoredGlobs": {
          "order": 14,
          "type": "array",
          "default": [],
          "markdownDescription": "Extra file patterns to skip when building embeddings, such as `**/*.md` or `**/fixtures/**`. Only source, config and documentation files are indexed to begin with; binaries such as fonts and images are always skipped."
        },
        "pointer.enableLogging": {
          "order": 19,
          "type": "boolean",
          "default": true,
          "markdownDescription": "Writes what Pointer is doing to the **Pointer** output channel: one line per completion or chat request with model, timing, size and why it stopped. Set the channel's log level to *Debug* (the dropdown in the Output panel) to also see the prompts and replies. Warnings and errors are written even when this is off."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint src crates/pointer-highlight/js",
    "lint:fix": "eslint src crates/pointer-highlight/js --fix",
    "vscode:package": "npm exec vsce package",
    "vscode:prepublish": "npm run build",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p . --noEmit",
    "check:mcp": "node scripts/checkMcp.mjs",
    "check:highlight": "node crates/pointer-highlight/parity.mjs",
    "check:trueforge": "node scripts/checkTrueforge.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.2.18",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@vscode/vsce": "^3.1.1",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pointersh/highlight": "0.1.0",
    "@truefoundry/trueforge-sdk": "^0.185.0",
    "clsx": "^2.1.1",
    "glimm": "^0.4.1",
    "ignore": "^6.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "workspaces": [
    "crates/pointer-highlight"
  ]
}
