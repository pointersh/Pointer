{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["es6", "dom"],
    "module": "commonjs",
    "moduleResolution": "node",
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "paths": {
      "@modelcontextprotocol/sdk/*": ["./node_modules/@modelcontextprotocol/sdk/dist/cjs/*"],
      "@pointersh/highlight": ["./crates/pointer-highlight/js/index.ts"],
      "@pointersh/highlight/react": ["./crates/pointer-highlight/js/react.tsx"]
    },
    "sourceMap": true,
    "strict": true,
    "target": "ES2020",
    "skipLibCheck": true,
    "typeRoots": [
      "node_modules/@types",
      "src/common/types.ts"
    ]
  },
  "include": ["src/**/*", "crates/pointer-highlight/js/**/*"],
  "exclude": ["node_modules", "out", "dist"]
}
